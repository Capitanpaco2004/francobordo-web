# Propaga el header Authorization a PHP-FPM (necesario para api-orders.php)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
</IfModule>


## Disable mod_security for the VStock sync endpoints — the WAF redacts our
## auth tokens otherwise. Endpoints already use Bearer + IP allowlist.
<Files "api-stock-sync.php">
    <IfModule mod_security.c>
        SecRuleEngine Off
    </IfModule>
    <IfModule security2_module>
        SecRuleEngine Off
    </IfModule>
</Files>
<Files "api-stock-sync-status.php">
    <IfModule mod_security.c>
        SecRuleEngine Off
    </IfModule>
    <IfModule security2_module>
        SecRuleEngine Off
    </IfModule>
</Files>
# denox-block-md  (bloquea acceso HTTP a ficheros markdown - gestionado por denox, no tocar)
<FilesMatch "\.(md|markdown|mdown|mkd)$">
    Require all denied
</FilesMatch>
# end denox-block-md


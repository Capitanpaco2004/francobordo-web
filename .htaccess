# Exclude public product feeds (/fm-feeds/) from the bad-bot redirect so
# automated fetchers (SalesManago, Google, Doofinder) using wget/curl UAs
# can download the XML/TXT feeds. Added 2026-06-02 for SalesManago.
RewriteCond %{REQUEST_URI} !^/fm-feeds/ [NC]
RewriteRule ^.*$ https://www.google.com [R,L]
RewriteCond %{HTTP_HOST} ^francobordo\.net$ [OR]
RewriteCond %{HTTP_HOST} ^www\.francobordo\.net$
RewriteRule ^(.*)$ "https\:\/\/www\.francobordo\.com\/$1" [R=301,L]


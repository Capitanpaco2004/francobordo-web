<IfModule Litespeed>
    RewriteEngine On
    RewriteRule .* - [E=noabort:1, E=noconntimeout:1]
</IfModule>
<FilesMatch "\.(csv)$">
  Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
</FilesMatch>

# Reset htaccess anteriores
RewriteEngine Off
RewriteEngine On

deny from all

#IP del Servidor
allow from 20.71.1.14
#IP de casa
allow from 95.124.191.7

#IP Empresa
allow from 217.127.199.171
#IP Andorra
allow from 145.224.124.130
#IP Starlink
allow from 209.198.137.63

# VPN Kadevia
#allow from 51.91.52.168

# Evitar que la regla heredada del htaccess raiz elimine index.php y redirija a /
RewriteRule ^index\.php$ - [L]
# Style para solenopsis
RewriteCond %{REQUEST_URI} ^(.+)/style_base.css$
RewriteRule ^.+/style_base.css$ %1/style.php [R=301,L]

## Redirecciones 301 con www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTPS}:s on:(s)
RewriteRule (.*)$ http%1://www.%{HTTP_HOST}/_admin/$1 [R=301,L,NE]

## Si esta sin SSL redirecciono a SSL
RewriteCond %{HTTPS} off
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

# Addons
RewriteRule ^addon_(.+).php /_admin/addons.php

<Files "cron_mail_status.php">
   Allow from all
</Files>

# Restriccion especifica para los endpoints del traspaso QFacWin (C4):
# solo accesibles desde la IP del ERP/oficina, IPs de servidor y localhost.
# Cierra la superficie de SQLi de estos scripts sin tocar el codigo del proveedor
# (QFacWin sube sus scripts por FTP y llama por HTTP desde 217.127.199.171).
<FilesMatch "^qfacwin_.*\.php$">
   Order deny,allow
   Deny from all
   Allow from 217.127.199.171
   Allow from 80.28.193.44
   Allow from 20.71.1.14
   Allow from 127.0.0.1
   Allow from ::1
</FilesMatch>
